# Copy to .env.deepseek.local. Never commit the populated local file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# SCNet Token Plan alternative (requires the platform's dedicated Token Plan key):
# DEEPSEEK_BASE_URL=https://api.scnet.cn/api/llm/v1
# DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017-Event
# 2026-11-15 real pilot returned 403: current model does not support Token Plan.
# User-supplied Event ID succeeded in a separate explicit five-sense pilot.
DEEPSEEK_MAX_REQUESTS=120
DEEPSEEK_TOKEN_LIMIT=300000
DEEPSEEK_BATCH_SIZE=5
DEEPSEEK_MAX_RPM=4
