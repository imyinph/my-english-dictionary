# Copy to project root .env.m3.local; never place keys in public/ or chat.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3-flash-preview
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_API_VERSION=3.0
M3_GEMINI_MAX_RPM=8
M3_GEMINI_BATCH_SIZE=5
M3_DRY_RUN=false
M3_MAX_REQUESTS=120
M3_AZURE_CHARACTER_LIMIT=30000
M3_GEMINI_TOKEN_LIMIT=300000
