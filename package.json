{
  "name": "personal-dictionary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python scripts/audio_rates.py && node scripts/exampleTranslations.mjs && node scripts/chineseSamples.ts && node scripts/chineseContent.ts verify && node scripts/senseTranslations.ts verify && node scripts/verifyAudio.ts && tsc --noEmit && vite build && python scripts/audio_rates.py --dist && node scripts/verifyAudio.ts --dist && node scripts/chineseContent.ts verify --dist && node scripts/senseTranslations.ts verify --dist && node scripts/chineseSamples.ts --dist",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/providers/*.test.ts scripts/*.test.mjs scripts/*.test.ts && python -m unittest discover -s scripts -p test_ecdict_import.py",
    "audio:plan": "node scripts/polly.ts",
    "audio:generate": "node scripts/polly.ts --generate",
    "data:refresh": "python scripts/import_kaikki.py",
    "test:e2e": "playwright test",
    "audio:preflight": "node scripts/polly.ts --preflight",
    "audio:verify": "node scripts/verifyAudio.ts",
    "audio:verify-media": "node scripts/verifyPollyMedia.mjs",
    "release:build": "node scripts/verifyAudio.ts --complete && pnpm build",
    "content:scan": "node scripts/chineseContent.ts scan",
    "content:init": "node scripts/chineseContent.ts init",
    "content:verify": "node scripts/chineseContent.ts verify",
    "zh:migrate": "node scripts/senseTranslations.ts migrate",
    "zh:review-template": "node scripts/senseTranslations.ts review-template",
    "zh:review": "node scripts/senseTranslations.ts review",
    "zh:publish": "node scripts/senseTranslations.ts publish",
    "zh:verify": "node scripts/senseTranslations.ts verify",
    "ecdict:import": "python scripts/import_ecdict.py",
    "ecdict:match": "node scripts/match_ecdict.ts",
    "ecdict:verify": "python scripts/import_ecdict.py --verify && node scripts/match_ecdict.ts --verify",
    "ecdict:report": "node scripts/reportEcdict.ts",
    "zh:samples:publish": "node scripts/chineseSamples.ts --publish",
    "zh:samples:verify": "node scripts/chineseSamples.ts",
    "zh:import": "node scripts/senseTranslations.ts import",
    "zh:ai:plan": "node scripts/aiChinese.mjs",
    "m3:plan": "node scripts/m3/deepseekCli.mjs plan",
    "m3:preflight": "node scripts/m3/deepseekCli.mjs preflight",
    "m3:pilot": "node scripts/m3/deepseekCli.mjs pilot",
    "m3:run": "node scripts/m3/deepseekCli.mjs run",
    "m3:report": "node scripts/m3/deepseekCli.mjs report",
    "m3:accept": "node scripts/m3/deepseekCli.mjs accept",
    "m3:audit": "node scripts/m3/cli.mjs audit",
    "m3:azure": "node scripts/m3/cli.mjs azure",
    "m3:retry": "node scripts/m3/deepseekCli.mjs retry",
    "m3:probe": "node scripts/m3/deepseekCli.mjs probe",
    "m3:legacy-report": "node scripts/m3/cli.mjs report"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "3.1167.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.7"
  }
}
